# Copy to .env locally. Never commit endpoint credentials or signing keys.
# Fixed BSC custom-vault gates require archive state at block 125316166.
RPC_BSC=https://<bsc-archive-endpoint>
# Historical Robinhood tests accept a single URL OR whitespace-separated list.
# Do not set both RPC_ROBINHOOD and RPC_ROBINHOOD_LIST.
# RPC_ROBINHOOD=https://<robinhood-archive-endpoint>
# RPC_ROBINHOOD_LIST=https://<primary> https://<fallback>
FORK_STRICT_BLOCK=true
FORK_REQUIRED=true
# Deployment receiver and publisher identities must be reviewed explicitly.
# ATTESTATION_PUBLISHER=0x...
# DISTRIBUTOR_PUBLISHER=0x...
# COMMISSION_RECEIVER=0x...
# Legal hashes must match reviewed legal/attestation-v0 originals.
# ATTESTATION_V0_TERMS_HASH=0x...
# ATTESTATION_V0_ATTESTATION_HASH=0x...
